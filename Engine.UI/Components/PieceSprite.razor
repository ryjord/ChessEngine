@*
    An original vector piece set drawn from geometric primitives.

    Rendering pieces as inline SVG rather than as font glyphs or image files keeps
    them identical on every platform, lets them inherit colour from the theme, and
    means the app ships with no third-party artwork to attribute or licence. Each
    piece is drawn in a 45x45 box, filled in the side's colour and outlined in the
    opposite one so both stay legible on light and dark squares alike.
*@

<svg viewBox="0 0 45 45" role="img" aria-label="@Label" focusable="false">
    <g fill="@Fill" stroke="@Stroke" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
        @switch (Piece.TypeOf()) {
            case PieceType.Pawn:
                <circle cx="22.5" cy="12.6" r="5.4" />
                <path d="M22.5 18.4c-3.9 0-6.6 2.3-6.6 5 0 1.5.8 2.8 2 3.6-3.1 2-5.2 5.2-5.7 9.1h20.6c-.5-3.9-2.6-7.1-5.7-9.1 1.2-.8 2-2.1 2-3.6 0-2.7-2.7-5-6.6-5z" />
                <rect x="9.8" y="35.4" width="25.4" height="4.8" rx="2.2" />
                break;

            case PieceType.Knight:
                @*
                    Facing left, in the traditional orientation. The outline is a
                    single loop: down the back of the ear, along the maned neck to
                    the base, forward across the chest, out to the muzzle, then back
                    up the face to the brow.
                *@
                <path d="M23.2 5.8c2 .8 3.2 3 3.6 5.6 4.2 1.4 6.8 5 7.8 10.2.7 3.8.7 7.6.5 11.6H14.1c-.4-4.2 1.3-7.5 4.6-10L12.4 25.9c-2.2.9-3.6-1.7-2-3.8 2-2.7 4.5-5.1 7.4-7 1.4-.9 2.6-1.7 3.6-2.2l-.5-3.7c-.3-2.3.7-4 2.3-3.4z" />
                <circle cx="18.6" cy="18" r="1.2" fill="@Stroke" stroke="none" />
                <rect x="9.6" y="33.2" width="25.8" height="7" rx="2.4" />
                break;

            case PieceType.Bishop:
                <circle cx="22.5" cy="6.8" r="2.4" />
                @* A tall, narrow mitre; a wide one reads as a pot rather than a hat. *@
                <path d="M22.5 9.4c-3.9 3.9-6.2 8-6.2 11.6 0 3 1.4 5.4 3.5 7h5.4c2.1-1.6 3.5-4 3.5-7 0-3.6-2.3-7.7-6.2-11.6z" />
                @* One diagonal cut, not a cross: the cross is what makes it read as an orb. *@
                <path d="M19.4 22.6l6.2-7.8" stroke-width="1.6" />
                <rect x="15" y="28" width="15" height="3.6" rx="1.7" />
                <rect x="10.6" y="34.8" width="23.8" height="5.4" rx="2.3" />
                break;

            case PieceType.Rook:
                <path d="M11.4 19.8V10.6h4.7v3.5h4.1v-3.5h4.6v3.5h4.1v-3.5h4.7v9.2z" />
                <path d="M13.6 21.4h17.8l-1.2 12.2H14.8z" />
                <rect x="11" y="19.2" width="23" height="2.6" rx="0.8" />
                <rect x="11.6" y="33.2" width="21.8" height="3" rx="1.1" />
                <rect x="9.2" y="35.8" width="26.6" height="4.4" rx="1.8" />
                break;

            case PieceType.Queen:
                @* Five points tipped with balls: the crown that names the piece. *@
                <circle cx="22.5" cy="6.6" r="2.5" />
                <circle cx="12.6" cy="9.4" r="2.2" />
                <circle cx="32.4" cy="9.4" r="2.2" />
                <circle cx="7.4" cy="14.8" r="2.1" />
                <circle cx="37.6" cy="14.8" r="2.1" />
                <path d="M8.2 16.4L11.9 29.8h21.2L36.8 16.4l-6.6 5.6-3.7-10.2-4 8.8-4-8.8-3.7 10.2z" />
                <rect x="11" y="29.4" width="23" height="3.6" rx="1.5" />
                <rect x="9" y="34.8" width="27" height="5.4" rx="2.2" />
                break;

            case PieceType.King:
                <path d="M22.5 4.6v9.2M18 8.8h9" stroke-width="3" stroke-linecap="round" />
                @* Crown, band and flared body: three bands so it never reads as a pawn. *@
                <path d="M13.4 21.8c0-4.4 4.1-7.4 9.1-7.4s9.1 3 9.1 7.4z" />
                <rect x="12.6" y="21.2" width="19.8" height="3.2" rx="1.2" />
                @* The body is narrower than the band, which gives the king a waist. *@
                <path d="M16 24.4h13c1.7 4.2 1 8.2-1.8 11.4H17.8C15 32.6 14.3 28.6 16 24.4z" />
                <rect x="9.2" y="35.4" width="26.6" height="4.8" rx="2" />
                break;
        }
    </g>
</svg>

@code {
    [Parameter, EditorRequired]
    public Piece Piece { get; set; }

    private bool IsWhite => Piece.ColorOf() == Color.White;

    private string Fill => IsWhite ? "var(--white-piece)" : "var(--black-piece)";

    private string Stroke => IsWhite ? "var(--black-piece)" : "var(--white-piece)";

    private string Label => $"{(IsWhite ? "White" : "Black")} {Piece.TypeOf().ToString().ToLowerInvariant()}";
}
